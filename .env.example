onboard_READ_WRITE_TOKEN="vercel_blob_rw_B7liBmipXGSJ0MsI_W78yTG39m95CoyAy77o8BzUp75u3no"

# Public base URL of this deployment (used to build local upload links in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000
