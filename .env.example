# ---- Resend (transactional email) ----
# Create an API key at https://resend.com/api-keys (server-side only — never expose to the client)
RESEND_API_KEY=
# Verified sender, e.g. "PowerGrowthz Agency <onboarding@yourdomain.com>"
RESEND_FROM_EMAIL=PowerGrowthz Onboarding <onboarding@resend.dev>
# Where completed onboarding forms are sent
ONBOARDING_TO_EMAIL=eogunjimi82@gmail.com

# ---- File storage (uploads) ----
# Vercel Blob read/write token (https://vercel.com/docs/storage/vercel-blob)
# If not set, uploads fall back to local disk storage (development only).
BLOB_READ_WRITE_TOKEN=

# Public base URL of this deployment (used to build local upload links in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000
